taxis_comunidad_de_madrid = read.csv2("flotataxismadrid.csv")


taxis_filtrados_comunidad_de_madrid = taxis_comunidad_de_madrid[(taxis_comunidad_de_madrid$Marca == "TOYOTA" | taxis_comunidad_de_madrid$Marca == "SKODA"), ]
marca_del_coche = taxis_filtrados_comunidad_de_madrid$Marca
potencia_del_coche = taxis_filtrados_comunidad_de_madrid$Potencia
potencia_toyota = taxis_filtrados_comunidad_de_madrid$Potencia[taxis_filtrados_comunidad_de_madrid$Marca == "TOYOTA"]
potencia_skoda = taxis_filtrados_comunidad_de_madrid$Potencia[taxis_filtrados_comunidad_de_madrid$Marca == "SKODA"]




#Medidas de la muestra global
mean(potencia_del_coche, na.rm = TRUE)
median(potencia_del_coche, na.rm = TRUE)
sd(potencia_del_coche, na.rm = TRUE)
var(potencia_del_coche, na.rm = TRUE)
range(potencia_del_coche, na.rm = TRUE)
cv_global = sd(potencia_del_coche, na.rm = TRUE) / mean(potencia_del_coche, na.rm = TRUE)

quantile(potencia_del_coche, 0.25, type = 2, na.rm = TRUE)
quantile(potencia_del_coche, 0.50, type = 2, na.rm = TRUE)
quantile(potencia_del_coche, 0.75, type = 2, na.rm = TRUE)
IQR(potencia_del_coche, type = 2, na.rm = TRUE)

if (!require("e1071")) install.packages("e1071")
library(e1071)
skewness(potencia_del_coche, type = 3, na.rm = TRUE)
kurtosis(potencia_del_coche, type = 3, na.rm = TRUE)




