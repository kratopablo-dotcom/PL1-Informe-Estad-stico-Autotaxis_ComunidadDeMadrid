#Tablas y Diagramas
tabla_contingencia = table(marca_del_coche, potencia_del_coche)
prop.table(tabla_contingencia)

if (!require("qcc")) install.packages("qcc")
library (qcc)
pareto.chart(potencia_del_coche, main = "Diagrama de pareto de potencia", xlab = "Nº de taxis", ylab = "Frecuencia")
stem(potencia_del_coche, scale = 3)
pie(tabla_contingencia, col =  "pink", density = c(5,10,15,30))

hist(potencia_del_coche, main = "Histograma de Potencia", xlab = "CV/kW", ylab = "Nº de taxis", col = "green", border = "black")
abline(v=mean(potencia_del_coche), lwd=2, lty=3, col="darkred")
abline(v=median(potencia_del_coche), lwd=2, col="darkred")
h=hist(potencia_del_coche, main = "Histograma de Potencia", xlab = "CV/kW", ylab = "Nº de taxis", col = "green", border = "black")
lines(h$mids,h$counts, col="darkred", lwd=5)

boxplot(potencia_del_coche ~ marca_del_coche, main = "Boxplot de Potencia según Marca del coche", xlab = "Marca del coche", ylab = "CV/kW", col = "blue", border = "black")
barplot(tabla_contingencia, main = "Distribución de Potencia por Marca del coche", legend = TRUE, xlab = "CV/kW", ylab = "Número de taxis", border = "orange")
